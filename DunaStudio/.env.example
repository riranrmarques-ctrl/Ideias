# Porta do servidor
PORT=3000

# Caminho do site dentro do domínio (ex: /studio para dunabranding.com.br/studio). Deixe vazio para usar a raiz.
BASE_PATH=/studio

# Segredo usado para assinar os tokens de login (troque por uma string longa e aleatória)
JWT_SECRET=troque-isto-por-uma-string-bem-longa-e-aleatoria

# Conta de administrador criada automaticamente na primeira execução
ADMIN_EMAIL=voce@seudominio.com
ADMIN_PASSWORD=escolha-uma-senha-forte

# Credenciais do Cloudflare R2 (Painel R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=seu-account-id-cloudflare
R2_ACCESS_KEY_ID=sua-access-key
R2_SECRET_ACCESS_KEY=sua-secret-key
R2_BUCKET_NAME=wedding-flix-videos

# URL pública do bucket (dominio customizado conectado ao R2, sem barra no final)
# Ex: https://videos.seudominio.com
R2_PUBLIC_URL=https://videos.seudominio.com

# URL pública do site (usada nos links de retorno do Mercado Pago)
SITE_URL=http://localhost:3000/studio

# Mercado Pago (Painel MP -> Suas integrações -> Credenciais -> Produção)
MP_ACCESS_TOKEN=seu-access-token-de-producao

# E-mail (Gmail) usado pra notificar sobre novas vendas
# Crie uma "senha de app" em myaccount.google.com/apppasswords (exige verificação em 2 etapas ativada)
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app-de-16-digitos
NOTIFY_EMAIL=seuemail@gmail.com

